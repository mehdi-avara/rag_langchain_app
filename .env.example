# ─────────────────────────────────────────────────────────────────────────────
# .env.example
# Copy this file to .env and fill in your values.
# Lines marked REQUIRED must be set — the app will crash without them.
# Lines with a default are optional; the shown value is what the app uses.
# ─────────────────────────────────────────────────────────────────────────────


# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=porsa                        # REQUIRED
POSTGRES_USER=postgres                   # REQUIRED
POSTGRES_PASSWORD=changeme               # REQUIRED — use a strong password
POSTGRES_IP=postgres                     # service name in docker compose
POSTGRES_PORT=5432


# ── Default admin user (created on first run) ─────────────────────────────────
default_username=admin                   # REQUIRED
default_password=changeme                # REQUIRED
default_firstname=Admin                  # REQUIRED


# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
jwt_secret=changeme_generate_a_real_secret   # REQUIRED
jwt_exp_hours=24


# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
cors_allow_origins=["http://localhost:5000","https://porsa.mahta-tech.com"]

# Public base URL of this backend (used for generating links)
base_url=https://porsaapi.mahta-tech.com


# ── Redis ─────────────────────────────────────────────────────────────────────
# Overridden in docker-compose to redis://redis:6379/0
redis_url=redis://redis:6379/0
REDIS_PORT=6379


# ── Backend server ────────────────────────────────────────────────────────────
BACKEND_PORT=8001


# ── LLM (OpenAI-compatible endpoint) ─────────────────────────────────────────
openai_api_key=your_key_here             # REQUIRED
openai_base_url=http://10.0.0.10:11434/v1
openai_model=gpt-oss-120b

# Response generation
llm_model=gemma3:27b
llm_temperature=0.1

# Query rewriting
llm_rewrite_model=gemma3:27b
llm_rewrite_temperature=0.3
llm_max_tokens=150


# ── Embedding model ───────────────────────────────────────────────────────────
embedding_model=jina-embeddings-v3
embedding_dim=1024
embedding_base_url=http://10.0.0.10:8088/v1
embedding_api_key=None
jina_api_key=your_jina_api_key_here     # REQUIRED


# ── Speech-to-text (STT) ─────────────────────────────────────────────────────
# Overridden in docker-compose to http://stt:8010
STT_URL=http://stt:8010


# ── MinerU (PDF processing) ───────────────────────────────────────────────────
mineru_running_address=./mineru


# ── File storage (temp dir — real files go to S3/Minio) ──────────────────────
files_dir=/app/uploaded_files


# ── Logging ───────────────────────────────────────────────────────────────────
request_log_file=logs/api.log
request_log_path=/home/ubuntu/porsa_server/backend/logs/
request_log_max_chars=1024
request_log_max_file_size=10485760       # 10 MB
request_log_backup_count=5


# ─────────────────────────────────────────────────────────────────────────────
# S3 / Object Storage
# Dev:  use the minio block below
# Prod: use the AWS S3 block below (comment out the minio block)
# ─────────────────────────────────────────────────────────────────────────────

# ── Dev — Minio (local S3) ────────────────────────────────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin          # change this in real deployments
S3_BUCKET_NAME=porsa-assets
S3_REGION_NAME=us-east-1
S3_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin           # change this
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Prod — AWS S3 (uncomment and fill in, comment out minio block above) ──────
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_PUBLIC_ENDPOINT_URL=https://your-bucket.s3.us-east-1.amazonaws.com
# S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_BUCKET_NAME=your-prod-bucket
# S3_REGION_NAME=us-east-1
# S3_USE_SSL=true

# ── Upload limits (shared) ────────────────────────────────────────────────────
S3_UPLOAD_EXPIRES_SECONDS=900
S3_DOWNLOAD_EXPIRES_SECONDS=300
MAX_UPLOAD_SIZE_BYTES=104857600          # 100 MB
ALLOWED_UPLOAD_CONTENT_TYPES=application/pdf,image/png,image/jpeg,image/webp,text/plain,application/zip,audio/mpeg,audio/wav,video/mp4
